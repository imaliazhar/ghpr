{
  "name": "ghpr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ghpr": "./bin/ghpr.js"
  },
  "scripts": {
    "start": "tsx src/cli.tsx",
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "install:local": "npm run build && mkdir -p ~/.local/bin && cp dist/ghpr.mjs ~/.local/bin/ghpr && chmod +x ~/.local/bin/ghpr && echo 'Installed ~/.local/bin/ghpr'"
  },
  "dependencies": {
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
